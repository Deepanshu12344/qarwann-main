PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/qarwaan
NODE_ENV=development
# Comma-separated exact frontend origins. Never use * when admin cookies are enabled.
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Auth (admin)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Cookie settings: use none + true only when frontend/API are on different HTTPS sites.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
ADMIN_EMAIL=admin@qarwaan.com
# Generate with:  node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# Zoho Mail (SMTP) — used to deliver enquiry notifications
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_FROM_EMAIL=
ZOHO_TO_EMAIL=

# Brevo newsletter
BREVO_API_KEY=
BREVO_LIST_ID=
